    <script>
gsap.set("#finale-watermark-wrap", { x: 240.606, y: 25.261 });
      const tl = gsap.timeline({ paused: true });

      // =====================================================
      // ACT 1: GENESIS OF THE ROSE (0.0s -> 4.4s)
      // =====================================================
      tl.fromTo(
        ["#ring-1", "#ring-2", "#ring-3"],
        { scale: 0.84, opacity: 0 },
        { scale: 1.0, opacity: 1, duration: 2.6, stagger: 0.15, ease: "sine.out" },
        0
      );

      tl.fromTo(
        "#rose-morph-stack",
        { scale: 0.84, rotation: -22 },
        { scale: 1.0, rotation: 0, duration: 3.6, ease: "power2.out" },
        0
      );

      tl.fromTo(
        "#rose-layer-1",
        { opacity: 0 },
        { opacity: 1, duration: 0.45, ease: "power2.out" },
        0
      );

      // 1.25s -> 2.55s: Real Prosciutto Rose morphs radially from center out into Illustrated Rose
      tl.fromTo(
        "#rose-layer-2",
        { clipPath: "circle(0% at 50% 50%)" },
        { clipPath: "circle(75% at 50% 50%)", duration: 1.3, ease: "power2.inOut" },
        1.25
      );
      tl.fromTo(
        "#morph-wave-ring",
        { scale: 0.05, opacity: 0.95 },
        { scale: 1.02, opacity: 0, duration: 1.25, ease: "power2.out" },
        1.25
      );

      // 2.50s -> 3.65s: Illustrated Rose crystallizes into Minimalist Burgundy Emblem on Crisp White
      tl.fromTo(
        "#act1-white-iris",
        { clipPath: "circle(0% at 50% 50%)" },
        { clipPath: "circle(100% at 50% 50%)", duration: 1.15, ease: "power3.inOut" },
        2.50
      );
      tl.fromTo(
        "#rose-layer-3",
        { clipPath: "circle(0% at 50% 50%)" },
        { clipPath: "circle(75% at 50% 50%)", duration: 1.05, ease: "power3.inOut" },
        2.50
      );

      // 3.35s -> 4.30s: Swap to live 11-petal SVG vector and give each petal an elastic precision pulse
      tl.fromTo(
        "#act1-svg-rose-wrap",
        { opacity: 0, scale: 0.96 },
        { opacity: 1, scale: 1, duration: 0.35, ease: "back.out(1.8)" },
        3.35
      );
      tl.to("#rose-layer-1, #rose-layer-2, #rose-layer-3", { opacity: 0, duration: 0.25 }, 3.45);
      tl.fromTo(
        ".a1-petal",
        { scale: 0.92, transformOrigin: "50% 50%" },
        { scale: 1, duration: 0.55, stagger: 0.03, ease: "back.out(2.2)" },
        3.40
      );

      // =====================================================
      // ACT 2: TYPOGRAPHY & BENTO SYSTEM (4.3s -> 8.5s)
      // =====================================================
      tl.fromTo(
        "#act2-stage",
        { opacity: 0 },
        { opacity: 1, duration: 0.35, ease: "power2.out" },
        4.30
      );
      tl.fromTo(
        "#act2-watermark-bg",
        { rotation: -18, scale: 0.92 },
        { rotation: 6, scale: 1.0, duration: 4.0, ease: "sine.inOut" },
        4.30
      );

      tl.fromTo(
        ".a2-petal-path",
        { scale: 0.85, opacity: 0, transformOrigin: "50% 50%" },
        { scale: 1, opacity: 1, duration: 0.55, stagger: 0.025, ease: "back.out(1.6)" },
        4.35
      );
      tl.fromTo(
        ".a2-elys-letter",
        { y: 380, opacity: 0, scale: 0.75, transformOrigin: "50% 50%" },
        { y: 0, opacity: 1, scale: 1, duration: 0.55, stagger: 0.07, ease: "back.out(1.5)" },
        4.55
      );
      tl.fromTo(
        ".a2-arch-letter",
        { y: 220, opacity: 0, scale: 0.6, transformOrigin: "50% 50%" },
        { y: 0, opacity: 1, scale: 1, duration: 0.48, stagger: 0.04, ease: "back.out(1.6)" },
        4.70
      );

      // 5.95s -> 8.4s: Unfold the Bento Brand Sheet
      tl.to(
        "#act2-hero-assembly",
        { scale: 0.92, opacity: 0, duration: 0.45, ease: "power2.inOut" },
        5.95
      );
      tl.fromTo(
        "#bento-board",
        { opacity: 0 },
        { opacity: 1, duration: 0.35, ease: "power2.out" },
        6.00
      );
      tl.fromTo(
        "#bento-top-gold",
        { y: -40, scale: 0.94, opacity: 0 },
        { y: 0, scale: 1, opacity: 1, duration: 0.6, ease: "back.out(1.3)" },
        6.05
      );
      tl.fromTo(
        "#bento-mid-horiz",
        { x: 50, scale: 0.94, opacity: 0 },
        { x: 0, scale: 1, opacity: 1, duration: 0.6, ease: "back.out(1.3)" },
        6.20
      );
      tl.fromTo(
        ["#bento-bot-left-white", "#bento-badge-gold", "#bento-badge-white", "#bento-bot-right-watermark"],
        { y: 50, scale: 0.92, opacity: 0 },
        { y: 0, scale: 1, opacity: 1, duration: 0.6, stagger: 0.09, ease: "back.out(1.4)" },
        6.35
      );
      tl.fromTo(
        "#bento-giant-crop-rose",
        { rotation: -24, scale: 0.94 },
        { rotation: 8, scale: 1.0, duration: 2.2, ease: "sine.out" },
        6.35
      );

      // =====================================================
      // ACT 3: 8 VERTICAL 9:16 MOCKUPS SHOWCASE (8.3s -> 14.7s)
      // =====================================================
      tl.fromTo(
        "#act3-stage",
        { clipPath: "inset(100% 0% 0% 0%)" },
        { clipPath: "inset(0% 0% 0% 0%)", duration: 0.55, ease: "power3.inOut" },
        8.30
      );
      tl.fromTo(
        "#act3-gold-frame",
        { opacity: 0, scale: 0.96 },
        { opacity: 1, scale: 1, duration: 0.6, ease: "power2.out" },
        8.50
      );

      const mockupTimes = [8.30, 9.10, 9.90, 10.70, 11.50, 12.30, 13.10, 13.90];
      mockupTimes.forEach((startT, idx) => {
        const slideId = `#m-slide-${idx + 1}`;
        const wrapId = `#m-wrap-${idx + 1}`;
        const zoomIn = idx % 2 === 0;

        if (idx === 0) {
          tl.set(slideId, { opacity: 1 }, startT);
        } else {
          tl.fromTo(
            slideId,
            { opacity: 0, clipPath: idx % 2 === 1 ? "inset(0% 0% 100% 0%)" : "inset(100% 0% 0% 0%)" },
            { opacity: 1, clipPath: "inset(0% 0% 0% 0%)", duration: 0.32, ease: "power2.out" },
            startT
          );
        }

        tl.fromTo(
          wrapId,
          { scale: zoomIn ? 1.07 : 1.0, y: zoomIn ? 14 : -14 },
          { scale: zoomIn ? 1.0 : 1.07, y: zoomIn ? -10 : 10, duration: 0.95, ease: "sine.inOut" },
          startT
        );
      });

      // =====================================================
      // ACT 4: HERO FINALE ON CHAMPAGNE GOLD (14.4s -> 17.5s)
      // =====================================================
      tl.fromTo(
        "#act4-stage",
        { clipPath: "circle(0% at 50% 50%)" },
        { clipPath: "circle(100% at 50% 50%)", duration: 0.85, ease: "power3.inOut" },
        14.40
      );
      tl.fromTo(
        "#finale-frame-border",
        { scale: 0.94, opacity: 0 },
        { scale: 1, opacity: 1, duration: 0.7, ease: "power2.out" },
        14.70
      );
      tl.fromTo(
        "#finale-watermark-wrap",
        { rotation: -20, scale: 0.90, opacity: 0 },
        { rotation: 6, scale: 1.0, opacity: 0.48, duration: 2.8, ease: "sine.out" },
        14.55
      );

      tl.fromTo(
        ".fin-petal-path",
        { scale: 0.25, rotation: -95, opacity: 0, transformOrigin: "50% 50%" },
        { scale: 1, rotation: 0, opacity: 1, duration: 0.75, stagger: 0.045, ease: "back.out(1.45)" },
        14.65
      );
      tl.fromTo(
        ".fin-arch-letter",
        { y: 220, opacity: 0, scale: 0.5, transformOrigin: "50% 50%" },
        { y: 0, opacity: 1, scale: 1, duration: 0.5, stagger: 0.04, ease: "back.out(1.5)" },
        15.10
      );
      tl.fromTo(
        ".fin-elys-letter",
        { y: 340, opacity: 0, scale: 0.65, transformOrigin: "50% 50%" },
        { y: 0, opacity: 1, scale: 1, duration: 0.55, stagger: 0.075, ease: "back.out(1.4)" },
        15.20
      );

      tl.fromTo(
        "#finale-lockup-wrap",
        { scale: 0.97 },
        { scale: 1.015, duration: 2.2, ease: "sine.out" },
        15.30
      );

      window.__timelines["main"] = tl;
    </script>
